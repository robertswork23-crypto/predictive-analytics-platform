# Copy to .env for local dev. In production this is set as a Railway service
# Variable, never committed.

ENVIRONMENT=development

# Leave unset locally to fall back to SQLite (./predictive_analytics.db). Must
# be a real Postgres connection string in production.
DATABASE_URL=

# How often the background job retrains and picks a (possibly new) best model.
RETRAIN_INTERVAL_MINUTES=30
